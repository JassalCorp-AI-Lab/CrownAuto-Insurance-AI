# ─── Required ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Models ───────────────────────────────────────────────
CHAT_MODEL=gpt-6-luna
VISION_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Reasoning effort per role. Leave a value EMPTY for non-reasoning models
# (e.g. CHAT_MODEL=gpt-4o-mini → set all three to empty).
# Tool-calling agents must use "none" with gpt-6-luna on Chat Completions.
ROUTER_REASONING_EFFORT=low
VISION_REASONING_EFFORT=low
AGENT_REASONING_EFFORT=none

# ─── Optional ─────────────────────────────────────────────
# CHROMA_DIR=./data/chroma
# GRAPH_RECURSION_LIMIT=25
# MAX_IMAGE_MB=8
